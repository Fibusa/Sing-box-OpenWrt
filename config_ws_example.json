{
    "log": {
        "disabled": false,
        "level": "info"
    },
    "dns": {
        "strategy": "ipv4_only",
        "reverse_mapping": true,
        "servers": [
            {
                "type": "https",
                "tag": "dns-secure",
                "server": "8.8.8.8",
                "tls": {
                    "server_name": "dns.google"
                },
                "detour": "proxy-select"
            },
            {
                "type": "https",
                "tag": "dns-direct",
                "server": "77.88.8.88",
                "tls": {
                    "server_name": "safe.dot.dns.yandex.net"
                }
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "media",
                    "discord",
                    "development",
                    "telegram",
                    "apple"
                ],
                "server": "dns-secure"
            }
        ],
        "final": "dns-direct"
    },
    "inbounds": [
        {
            "tag": "all-in",
            "type": "tun",
            "interface_name": "tun0",
            "address": "172.16.0.1/30",
            "mtu": 9000,
            "stack": "mixed",
            "auto_route": true
        }
    ],
    "outbounds": [
        {
            "type": "vless",
            "tag": "ws-out",
            "server": "",
            "server_port": 443,
            "uuid": "",
            "flow": "xtls-rprx-vision",
            "tls": {
                "enabled": true,
                "insecure": false,
                "server_name": "",
                "utls": {
                    "enabled": true,
                    "fingerprint": "firefox"
                }
            },
            "transport": {
                "type": "ws",
                "path": "/test-ws/"
            }
        },
        {
            "type": "direct",
            "tag": "direct-out"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "action": "resolve",
                "server": "google-dns-udp"
            },
            {
                "type": "logical",
                "mode": "or",
                "action": "reject",
                "method": "default",
                "rules": [
                    {
                        "rule_set": [
                            "block"
                        ]
                    }
                ]
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "rule_set": [
                            "media",
                            "discord",
                            "development",
                            "telegram",
                            "apple"
                        ]
                    }
                ],
                "action": "route",
                "outbound": "ws-out"
            },
            {
                "inbound": "tun-in",
                "outbound": "direct-out"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "discord",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/discord.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            },
            {
                "type": "remote",
                "tag": "media",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/media.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            },
            {
                "type": "remote",
                "tag": "development",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/development.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            },
            {
                "type": "remote",
                "tag": "telegram",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/telegram.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            },
            {
                "type": "remote",
                "tag": "block",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/block.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            },
            {
                "type": "remote",
                "tag": "apple",
                "format": "source",
                "url": "https://raw.githubusercontent.com/Fibusa/Sing-box-OpenWrt/refs/heads/main/rulesets/apple.json",
                "download_detour": "direct-out",
                "update_interval": "10m"
            }
        ],
        "default_domain_resolver": "google-dns-udp",
        "auto_detect_interface": true,
        "final": "direct-out"
    }
}